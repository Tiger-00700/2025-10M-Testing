{
  "testPlan": {
    "name": "BigDataAPI Test",
    "threadGroup": {
      "name": "API Users",
      "numThreads": 100,
      "rampUp": 60,
      "loopCount": 10
    },
    "httpRequests": [
      {
        "name": "Submit Job",
        "url": "http://spark-cluster:8080/api/v1/submit",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"jobName\":\"${__RandomString(8,abcdefghijklmnopqrstuvwxyz)}\",\"parameters\":{\"input\":\"/data/input\",\"output\":\"/data/output\"}}"
      },
      {
        "name": "Check Status",
        "url": "http://spark-cluster:8080/api/v1/job/${jobId}/status",
        "method": "GET"
      }
    ],
    "listeners": [
      "ResultCollector",
      "SummaryReport"
    ]
  }
}
