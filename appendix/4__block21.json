{
  "name": "customer_data_quality",
  "process.type": "BATCH",
  "data.sources": [
    {
      "name": "source_data",
      "connector": {
        "type": "hive",
        "version": "1.2",
        "config": {
          "database": "customer_db",
          "table": "source_customer"
        }
      }
    },
    {
      "name": "target_data",
      "connector": {
        "type": "hive",
        "version": "1.2",
        "config": {
          "database": "customer_db",
          "table": "target_customer"
        }
      }
    }
  ],
  "evaluate.rule": {
    "rules": [
      {
        "dsl.type": "griffin-dsl",
        "dq.type": "ACCURACY",
        "out.dataframe.name": "accuracy_result",
        "rule": "source_data.id = target_data.id AND source_data.name = target_data.name",
        "details": {
          "source": "source_data",
          "target": "target_data",
          "miss": "miss_count",
          "total": "total_count"
        },
        "threshold": {
          "type": "accuracy",
          "value": 0.99,
          "action": "ALERT"
        }
      },
      {
        "dsl.type": "griffin-dsl",
        "dq.type": "COMPLETENESS",
        "out.dataframe.name": "completeness_result",
        "rule": "source_data.id IS NOT NULL AND source_data.name IS NOT NULL",
        "details": {
          "source": "source_data",
          "target": "",
          "miss": "miss_count",
          "total": "total_count"
        },
        "threshold": {
          "type": "completeness",
          "value": 0.98,
          "action": "ALERT"
        }
      }
    ]
  },
  "sinks": [
    {
      "type": "CONSOLE",
      "config": {
        "max.log.lines": 1000
      }
    },
    {
      "type": "HDFS",
      "config": {
        "path": "/griffin/quality-result"
      }
    },
    {
      "type": "ELASTICSEARCH",
      "config": {
        "host": "es-host",
        "port": 9200,
        "index": "griffin_quality"
      }
    }
  ]
}
