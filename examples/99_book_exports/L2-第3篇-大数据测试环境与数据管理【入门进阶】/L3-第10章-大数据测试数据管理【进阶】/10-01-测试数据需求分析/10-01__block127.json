{
  "title": "大数据流水线监控仪表盘",
  "panels": [
    {
      "id": "throughput_monitor",
      "type": "line",
      "title": "流水线吞吐量监控",
      "query": {
        "query_string": {
          "query": "source_type:data_pipeline AND event_type:stage_complete"
        }
      },
      "visState": {
        "metrics": [
          {
            "id": "avg-throughput",
            "type": "avg",
            "field": "throughput"
          }
        ],
        "buckets": [
          {
            "id": "time",
            "type": "date_histogram",
            "field": "@timestamp",
            "interval": "5m"
          },
          {
            "id": "pipeline",
            "type": "terms",
            "field": "pipeline"
          }
        ]
      }
    },
    {
      "id": "error_dashboard",
      "type": "metric",
      "title": "实时错误统计",
      "query": {
        "query_string": {
          "query": "level:ERROR OR level:CRITICAL"
        }
      },
      "visState": {
        "metrics": [
          {
            "id": "error-count",
            "type": "count"
          }
        ],
        "buckets": [
          {
            "id": "time",
            "type": "date_histogram",
            "field": "@timestamp",
            "interval": "1m"
          }
        ]
      }
    },
    {
      "id": "latency_heatmap",
      "type": "heatmap",
      "title": "处理延迟热力图",
      "query": {
        "query_string": {
          "query": "source_type:data_pipeline"
        }
      },
      "visState": {
        "metrics": [
          {
            "id": "latency-matrix",
            "type": "avg",
            "field": "processing_time_ms"
          }
        ],
        "buckets": [
          {
            "id": "pipeline",
            "type": "terms",
            "field": "pipeline",
            "size": 10
          },
          {
            "id": "stage",
            "type": "terms",
            "field": "stage",
            "size": 10
          }
        ]
      }
    },
    {
      "id": "data_quality_gauge",
      "type": "gauge",
      "title": "数据质量指标",
      "query": {
        "query_string": {
          "query": "source_type:data_pipeline AND data_quality:*"
        }
      },
      "visState": {
        "metrics": [
          {
            "id": "quality-avg",
            "type": "avg",
            "field": "data_quality"
          }
        ],
        "buckets": [
          {
            "id": "pipeline",
            "type": "terms",
            "field": "pipeline",
            "size": 5
          }
        ],
        "gauge": {
          "minValue": 0,
          "maxValue": 1,
          "thresholds": [0.8, 0.9, 0.95]
        }
      }
    }
  ]
}
