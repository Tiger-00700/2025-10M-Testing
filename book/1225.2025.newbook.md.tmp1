# Spark DataFrame转换单元测试
def test_spark_data_transformation(spark_session):
    # 创建测试数据
    test_data = [("user1", 100, "2023-01-01"),
                 ("user2", 200, "2023-01-02")]
    df = spark_session.createDataFrame(test_data, ["user_id", "amount", "date"])
    
    # 执行转换逻辑
    result_df = transform_user_data(df)
    
    # 断言验证
    assert result_df.count() == 2
    assert "processed_amount" in result_df.columns
    # 验证数据准确性
    result_rows = result_df.collect()
    assert result_rows[0]["processed_amount"] == 100 * 1.1  # 假设有10%加成

# Flink流处理单元测试
def test_flink_stream_processing():
    # 创建测试环境
    env = StreamExecutionEnvironment.get_execution_environment()
    env.set_parallelism(1)  # 测试环境使用单并行度
    
    # 创建测试数据流
    data_stream = env.from_collection([
        ("sensor1", 25.5, "2023-01-01 10:00:00"),
        ("sensor2", 30.2, "2023-01-01 10:00:01")
    ])
    
    # 执行处理逻辑
    processed_stream = process_sensor_data(data_stream)
    
    # 收集结果并验证
    results = []
    processed_stream.add_sink(CollectingSink(results))
    env.execute()
    
    assert len(results) == 2
    assert results[0][1] > 25.5  # 假设有温度校正
```

**数据质量校验SQL脚本示例**:
```sql
-- 数据完整性检查
SELECT 
    table_name,
    COUNT(*) as total_records,
    COUNT(CASE WHEN user_id IS NOT NULL THEN 1 END) as valid_user_ids,
    COUNT(CASE WHEN amount IS NOT NULL AND amount > 0 THEN 1 END) as valid_amounts,
    ROUND(
        (COUNT(CASE WHEN user_id IS NOT NULL AND amount IS NOT NULL AND amount > 0 THEN 1 END) * 100.0) / COUNT(*), 
        2
    ) as completeness_percentage
FROM user_transactions 
WHERE created_date >= '2023-01-01'
GROUP BY table_name;

-- 数据一致性检查（跨表对账）
SELECT 
    'user_summary_vs_transactions' as check_type,
    COUNT(DISTINCT t.user_id) as transaction_users,
    COUNT(DISTINCT s.user_id) as summary_users,
    ABS(COUNT(DISTINCT t.user_id) - COUNT(DISTINCT s.user_id)) as user_count_diff,
    CASE 
        WHEN ABS(COUNT(DISTINCT t.user_id) - COUNT(DISTINCT s.user_id)) = 0 THEN 'PASS'
        ELSE 'FAIL'
    END as consistency_status
FROM user_transactions t
FULL OUTER JOIN user_summary s ON t.user_id = s.user_id;

-- 数据质量趋势分析
SELECT 
    DATE(created_date) as date,
    COUNT(*) as daily_records,
    AVG(amount) as avg_amount,
    STDDEV(amount) as amount_stddev,
    COUNT(CASE WHEN amount < 0 THEN 1 END) as negative_amounts,
    ROUND(
        COUNT(CASE WHEN amount BETWEEN 0 AND 10000 THEN 1 END) * 100.0 / COUNT(*), 
        2
    ) as normal_amount_percentage
FROM user_transactions
WHERE created_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY)
GROUP BY DATE(created_date)
ORDER BY date DESC;
```

**监控指标采集Python脚本示例**:
```python
import psutil
import time
from datetime import datetime
import json
import requests

class SystemMonitor:
    def __init__(self, collection_interval=60):
        self.collection_interval = collection_interval
        self.metrics_history = []
        
    def collect_system_metrics(self):
        """采集系统级监控指标"""
        metrics = {
            "timestamp": datetime.now().isoformat(),
            "cpu": {
                "usage_percent": psutil.cpu_percent(interval=1),
                "count": psutil.cpu_count(),
                "load_average": psutil.getloadavg() if hasattr(psutil, 'getloadavg') else None
            },
            "memory": {
                "total_gb": round(psutil.virtual_memory().total / (1024**3), 2),
                "used_gb": round(psutil.virtual_memory().used / (1024**3), 2),
                "usage_percent": psutil.virtual_memory().percent,
                "available_gb": round(psutil.virtual_memory().available / (1024**3), 2)
            },
            "disk": {
                "total_gb": round(psutil.disk_usage('/').total / (1024**3), 2),
                "used_gb": round(psutil.disk_usage('/').used / (1024**3), 2),
                "usage_percent": psutil.disk_usage('/').percent,
                "free_gb": round(psutil.disk_usage('/').free / (1024**3), 2)
            },
            "network": {
                "bytes_sent": psutil.net_io_counters().bytes_sent,
                "bytes_recv": psutil.net_io_counters().bytes_recv,
                "packets_sent": psutil.net_io_counters().packets_sent,
                "packets_recv": psutil.net_io_counters().packets_recv
            }
        }
        return metrics
    
    def collect_application_metrics(self, process_name="spark"):
        """采集应用级监控指标"""
        app_metrics = {
            "timestamp": datetime.now().isoformat(),
            "application": process_name,
            "process_count": 0,
            "total_cpu_percent": 0,
            "total_memory_mb": 0,
            "processes": []
        }
        
        for proc in psutil.process_iter(['pid', 'name', 'cpu_percent', 'memory_info']):
            try:
                if process_name.lower() in proc.info['name'].lower():
                    proc_metrics = {
                        "pid": proc.info['pid'],
                        "name": proc.info['name'],
                        "cpu_percent": proc.info['cpu_percent'],
                        "memory_mb": round(proc.info['memory_info'].rss / (1024**2), 2)
                    }
                    app_metrics["processes"].append(proc_metrics)
                    app_metrics["process_count"] += 1
                    app_metrics["total_cpu_percent"] += proc.info['cpu_percent']
                    app_metrics["total_memory_mb"] += proc_metrics["memory_mb"]
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                continue
                
        return app_metrics
    
    def send_to_monitoring_system(self, metrics, endpoint="http://monitoring.example.com/api/metrics"):
        """发送指标到监控系统"""
        try:
            response = requests.post(endpoint, 
                                   json=metrics, 
                                   headers={'Content-Type': 'application/json'},
                                   timeout=5)
            return response.status_code == 200
        except Exception as e:
            print(f"Failed to send metrics: {e}")
            return False
    
    def run_monitoring_loop(self):
        """运行监控循环"""
        print("Starting system monitoring...")
        while True:
            try:
                # 采集系统指标
                system_metrics = self.collect_system_metrics()
                
                # 采集应用指标
                app_metrics = self.collect_application_metrics()
                
                # 合并指标
                combined_metrics = {
                    "system": system_metrics,
                    "application": app_metrics
                }
                
                # 发送到监控系统
                success = self.send_to_monitoring_system(combined_metrics)
                if success:
                    print(f"Metrics collected and sent at {system_metrics['timestamp']}")
                else:
                    print("Failed to send metrics")
                
                # 存储历史数据（保留最近100个数据点）
                self.metrics_history.append(combined_metrics)
                if len(self.metrics_history) > 100:
                    self.metrics_history.pop(0)
                    
            except Exception as e:
                print(f"Monitoring error: {e}")
            
            time.sleep(self.collection_interval)

# 使用示例
if __name__ == "__main__":
    monitor = SystemMonitor(collection_interval=30)  # 30秒采集一次
    monitor.run_monitoring_loop()
```

