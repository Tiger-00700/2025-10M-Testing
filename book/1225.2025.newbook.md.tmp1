    library: "pandas"
    method: "sample"
    parameters:
      ratio: 0.1
      random_state: 42
  faker_generation:
    library: "faker"
    locale: "zh_CN"
    fields: ["user_id", "name", "email", "phone", "address"]
  property_based:
    library: "hypothesis"
    strategy: "lists"
