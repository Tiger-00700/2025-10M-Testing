**数据质量自动化检查脚本示例**:
```python
import pandas as pd
import numpy as np
from datetime import datetime, timedelta
import logging
import json

class DataQualityChecker:
    def __init__(self, data_source):
        self.data_source = data_source
        self.logger = logging.getLogger(__name__)
        self.quality_report = {
            "timestamp": None,
            "dataset": data_source,
            "checks": [],
            "overall_score": 0,
            "recommendations": []
        }
    
    def load_data(self, query=None):
        """加载数据进行质量检查"""
        try:
            if isinstance(self.data_source, str) and self.data_source.endswith('.csv'):
                self.df = pd.read_csv(self.data_source)
            elif isinstance(self.data_source, pd.DataFrame):
                self.df = self.data_source
            else:
                # 假设是数据库连接，这里简化处理
                self.df = pd.DataFrame()  # 实际实现中需要数据库连接
            return True
        except Exception as e:
            self.logger.error(f"Failed to load data: {e}")
            return False
    
    def check_completeness(self):
        """检查数据完整性"""
        total_rows = len(self.df)
        completeness_results = {}
        
        for column in self.df.columns:
            null_count = self.df[column].isnull().sum()
            completeness_rate = (total_rows - null_count) / total_rows
            completeness_results[column] = {
                "completeness_rate": round(completeness_rate, 4),
                "null_count": int(null_count),
                "status": "PASS" if completeness_rate >= 0.95 else "FAIL"
            }
        
        return {
            "check_type": "completeness",
            "results": completeness_results,
            "overall_completeness": round(np.mean([v["completeness_rate"] for v in completeness_results.values()]), 4)
        }
    
    def check_uniqueness(self):
        """检查数据唯一性"""
        uniqueness_results = {}
        
        for column in self.df.columns:
            unique_count = self.df[column].nunique()
            total_count = len(self.df)
            uniqueness_rate = unique_count / total_count
            uniqueness_results[column] = {
                "unique_count": unique_count,
                "uniqueness_rate": round(uniqueness_rate, 4),
                "duplicate_count": total_count - unique_count
            }
        
        return {
            "check_type": "uniqueness",
            "results": uniqueness_results
        }
    
    def check_consistency(self, rules=None):
        """检查数据一致性"""
        consistency_results = []

        # 示例规则：检查数值范围
        if rules is None:
            rules = {
                "amount": {"min": 0, "max": 1000000},
                "age": {"min": 0, "max": 150},
                "score": {"min": 0, "max": 100}
            }

        try:
            for column, rule in rules.items():
                if column not in self.df.columns:
                    self.logger.warning(f"列 '{column}' 不存在于数据中，跳过一致性检查")
                    continue

                min_val = rule.get("min")
                max_val = rule.get("max")

                if min_val is not None and max_val is not None:
                    # 检查数据类型是否为数值型
                    if not pd.api.types.is_numeric_dtype(self.df[column]):
                        consistency_results.append({
                            "column": column,
                            "rule": f"range_{min_val}_{max_val}",
                            "error": "非数值类型列无法进行范围检查",
                            "valid_rate": 0.0
                        })
                        continue

                    # 处理NaN值
                    valid_data = self.df[column].dropna()
                    if len(valid_data) == 0:
                        consistency_results.append({
                            "column": column,
                            "rule": f"range_{min_val}_{max_val}",
                            "error": "列中无有效数值数据",
                            "valid_rate": 0.0
                        })
                        continue

                    invalid_count = ((valid_data < min_val) | (valid_data > max_val)).sum()
                    valid_rate = round(1 - invalid_count / len(valid_data), 4)

                    consistency_results.append({
                        "column": column,
                        "rule": f"range_{min_val}_{max_val}",
                        "invalid_count": int(invalid_count),
                        "valid_rate": valid_rate,
                        "total_checked": len(valid_data)
                    })
                else:
                    consistency_results.append({
                        "column": column,
                        "rule": "incomplete_rule",
                        "error": "规则不完整，缺少min或max值",
                        "valid_rate": 0.0
                    })

        except Exception as e:
            self.logger.error(f"一致性检查过程中发生错误: {str(e)}")
            consistency_results.append({
                "error": f"一致性检查失败: {str(e)}",
                "valid_rate": 0.0
            })

        return {
            "check_type": "consistency",
            "results": consistency_results
        }
    
    def check_accuracy(self, reference_data=None):
        """检查数据准确性（需要参考数据）"""
        accuracy_results = []
        
        if reference_data is not None:
            # 这里实现与参考数据的比对逻辑
            # 简化示例：检查数据类型一致性
            for column in self.df.columns:
                if column in reference_data.columns:
                    type_match = self.df[column].dtype == reference_data[column].dtype
                    accuracy_results.append({
                        "column": column,
                        "type_consistency": type_match,
                        "sample_values_match": True  # 简化检查
                    })
        
        return {
            "check_type": "accuracy",
            "results": accuracy_results
        }
    
    def generate_recommendations(self, check_results):
        """基于检查结果生成改进建议"""
        recommendations = []
        
        for check in check_results:
            if check["check_type"] == "completeness":
                for col, result in check["results"].items():
                    if result["status"] == "FAIL":
                        recommendations.append(f"数据完整性不足：{col}列缺失率过高({(1-result['completeness_rate'])*100:.1f}%)，建议补充数据源")
            
            elif check["check_type"] == "consistency":
                for result in check["results"]:
                    if result["valid_rate"] < 0.95:
                        recommendations.append(f"数据一致性问题：{result['column']}列{result['invalid_count']}个值超出合理范围")
        
        return recommendations
    
    def run_quality_checks(self):
        """运行完整的数据质量检查"""
        self.quality_report["timestamp"] = datetime.now().isoformat()
        
        if not self.load_data():
            return self.quality_report
        
        # 执行各项检查
        checks = [
            self.check_completeness(),
            self.check_uniqueness(),
            self.check_consistency(),
            self.check_accuracy()
        ]
        
        self.quality_report["checks"] = checks
        
        # 计算总体质量分数
        scores = []
        for check in checks:
            if check["check_type"] == "completeness":
                scores.append(check["overall_completeness"])
            elif check["check_type"] == "consistency":
                if check["results"]:
                    scores.append(np.mean([r["valid_rate"] for r in check["results"]]))
        
        self.quality_report["overall_score"] = round(np.mean(scores), 4) if scores else 0
        
        # 生成建议
        self.quality_report["recommendations"] = self.generate_recommendations(checks)
        
        return self.quality_report
    
    def export_report(self, output_path=None):
        """导出质量检查报告"""
        if output_path is None:
            output_path = f"data_quality_report_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json"
        
        with open(output_path, 'w', encoding='utf-8') as f:
            json.dump(self.quality_report, f, ensure_ascii=False, indent=2)
        
        return output_path

# 使用示例
if __name__ == "__main__":
    # 创建示例数据
    sample_data = pd.DataFrame({
        "user_id": range(1, 101),
        "amount": np.random.uniform(10, 1000, 100),
        "age": np.random.randint(18, 80, 100),
        "score": np.random.uniform(0, 100, 100),
        "category": np.random.choice(["A", "B", "C"], 100)
    })
    
    # 添加一些缺失值和异常值来测试
    sample_data.loc[10:15, "amount"] = None
    sample_data.loc[20:22, "age"] = 200  # 异常年龄
    
    # 运行质量检查
    checker = DataQualityChecker(sample_data)
    report = checker.run_quality_checks()
    
    print("数据质量检查报告:")
    print(f"总体质量分数: {report['overall_score']:.2f}")
    print(f"检查项目数量: {len(report['checks'])}")
    print(f"改进建议数量: {len(report['recommendations'])}")
    
    # 导出报告
    report_file = checker.export_report()
    print(f"详细报告已保存到: {report_file}")
```
```
#### 1.4 大数据应用场景与业务价值

大数据技术在各行业的应用已经深入到业务核心，形成了多个成熟的应用场景：

**用户行为分析场景：**
- **电商推荐系统**：基于用户浏览、点击、购买行为数据，实时推荐个性化商品
- **内容分发平台**：根据用户兴趣和行为模式，优化内容推送策略
- **广告投放系统**：精准广告定向，提高ROI（投资回报率）

**风险控制场景：**
- **金融风控**：实时分析交易行为，识别欺诈和异常交易
- **保险理赔**：基于历史理赔数据，评估风险和定价
- **信用评估**：多维度数据融合，构建用户信用画像

**物联网与智能制造：**
- **设备预测性维护**：基于传感器数据，预测设备故障
- **供应链优化**：实时监控库存和物流状态，优化供应链效率
- **质量检测**：工业视觉和传感器数据分析，提升产品质量

**具体行业案例**:
- **电商平台**：每日处理10TB用户行为数据，实时推荐准确率需>90%，关键指标包括点击率、转化率和个性化匹配度
  - 点击率计算公式：点击率 = (点击次数 / 展示次数) × 100%
  - 转化率计算公式：转化率 = (购买用户数 / 访问用户数) × 100%
- **金融风控系统**：处理PB级交易数据，风控模型准确率需>95%，关注欺诈检测率和误报率控制在1%以内
  - 准确率计算公式：准确率 = (正确预测数 / 总预测数) × 100%
  - 误报率计算公式：误报率 = (误报数 / 总预测数) × 100%
- **智能交通**：实时处理城市交通传感器数据，预测拥堵准确率>85%，关键指标包括数据延迟<500ms和完整性>99.9%
  - 数据完整性计算公式：完整性 = (有效数据点 / 总数据点) × 100%
- **医疗健康**：处理医院电子病历和基因组学数据，诊断准确率需>98%，关键指标包括数据隐私保护等级和响应时间<2秒
  - 诊断准确率计算公式：准确率 = (正确诊断数 / 总诊断数) × 100%
  - 药物研发效率提升：新药研发周期缩短30%，成功率提升20%
- **智能制造**：工业物联网设备产生TB级传感器数据，预测性维护准确率>90%，关键指标包括设备故障预测提前期和生产效率提升
  - 预测准确率计算公式：准确率 = (正确预测故障数 / 总预测数) × 100%
  - 生产效率提升：设备停机时间减少40%，产能提升25%
- **智慧城市**：整合城市各类传感器和监控数据，环境监测响应时间<5分钟，关键指标包括空气质量改善率和交通拥堵缓解度
  - 空气质量改善率计算公式：改善率 = ((当前PM2.5 - 基准PM2.5) / 基准PM2.5) × 100%
  - 交通拥堵缓解度：高峰期通行时间减少20%，市民满意度提升30%

**数据隔离与安全考虑：**
- **环境隔离**：生产、测试、开发环境严格分离，避免数据污染
- **租户隔离**：多租户场景下数据安全隔离，防止越权访问
- **数据脱敏**：敏感信息处理前进行脱敏，保护用户隐私

