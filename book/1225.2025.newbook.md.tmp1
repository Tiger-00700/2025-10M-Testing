**Python 随机采样脚本示例**:
```python
import pandas as pd
import numpy as np
from typing import Optional, Union
import logging

# 配置日志
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

def random_sampling(
    dataframe: pd.DataFrame,
    sample_ratio: float = 0.1,
    random_state: Optional[int] = 42,
    min_sample_size: int = 1
) -> pd.DataFrame:
    """
    随机采样函数，支持多种输入验证和错误处理

    Args:
        dataframe: 输入数据框
        sample_ratio: 采样比例 (0, 1]
        random_state: 随机种子，用于重现结果
        min_sample_size: 最小采样数量

    Returns:
        采样后的数据框

    Raises:
        ValueError: 当输入参数无效时
        TypeError: 当输入类型不正确时
    """
    try:
        # 输入验证
        if not isinstance(dataframe, pd.DataFrame):
            raise TypeError("输入必须是pandas DataFrame")

        if dataframe.empty:
            logger.warning("输入DataFrame为空，返回空DataFrame")
            return dataframe.copy()

        if not (0 < sample_ratio <= 1):
            raise ValueError("采样比例必须在(0, 1]范围内")

        # 计算采样大小
        total_size = len(dataframe)
        sample_size = max(min_sample_size, int(total_size * sample_ratio))

        # 确保采样大小不超过总大小
        sample_size = min(sample_size, total_size)

        logger.info(f"从{total_size}行数据中采样{sample_size}行")

        # 执行采样
        sampled_df = dataframe.sample(n=sample_size, random_state=random_state)

        # 验证采样结果
        if len(sampled_df) != sample_size:
            logger.warning(f"采样结果大小{len(sampled_df)}与预期{sample_size}不符")

        return sampled_df

    except Exception as e:
        logger.error(f"采样过程中发生错误: {str(e)}")
        raise

# 使用示例
if __name__ == "__main__":
    try:
        # df = pd.read_csv('large_dataset.csv')
        # sampled_df = random_sampling(df, sample_ratio=0.05)
        print("采样函数定义完成，可正常使用")
    except Exception as e:
        print(f"使用示例执行失败: {e}")
```

**Faker 生成测试数据脚本**:
```python
from faker import Faker
import pandas as pd

fake = Faker('zh_CN')

def generate_user_data(num_records=1000):
    """
    使用 Faker 生成用户测试数据
    """
    data = []
    for _ in range(num_records):
        user = {
            'user_id': fake.uuid4(),
            'name': fake.name(),
            'email': fake.email(),
            'phone': fake.phone_number(),
            'address': fake.address(),
            'registration_date': fake.date_this_year()
        }
        data.append(user)
    return pd.DataFrame(data)

# 生成数据
