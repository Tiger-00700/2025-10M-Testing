```python
# cloud_storage_consistency_test.py
# 多云存储一致性测试示例

import boto3
from azure.storage.blob import BlobServiceClient
from google.cloud import storage
import hashlib
import time

class MultiCloudStorageTester:
    def __init__(self):
        # 初始化不同云的客户端
        self.s3_client = boto3.client('s3')
        self.azure_client = BlobServiceClient.from_connection_string("azure_connection_string")
        self.gcp_client = storage.Client()
    
    def upload_test_file(self, content, filename):
        """上传测试文件到所有云存储"""
        results = {}
        
        # AWS S3
        try:
            self.s3_client.put_object(Bucket='test-bucket-aws', Key=filename, Body=content)
            results['aws'] = {'status': 'success', 'timestamp': time.time()}
        except Exception as e:
            results['aws'] = {'status': 'failed', 'error': str(e)}
        
        # Azure Blob
        try:
            blob_client = self.azure_client.get_blob_client(container='test-container', blob=filename)
            blob_client.upload_blob(content, overwrite=True)
            results['azure'] = {'status': 'success', 'timestamp': time.time()}
        except Exception as e:
            results['azure'] = {'status': 'failed', 'error': str(e)}
        
        # Google Cloud Storage
        try:
            bucket = self.gcp_client.bucket('test-bucket-gcp')
            blob = bucket.blob(filename)
            blob.upload_from_string(content)
            results['gcp'] = {'status': 'success', 'timestamp': time.time()}
        except Exception as e:
            results['gcp'] = {'status': 'failed', 'error': str(e)}
        
        return results
    
    def verify_consistency(self, filename, expected_hash):
        """验证多云存储的一致性"""
        results = {}
        
        # 下载并验证AWS S3文件
        try:
            s3_response = self.s3_client.get_object(Bucket='test-bucket-aws', Key=filename)
            s3_content = s3_response['Body'].read()
            s3_hash = hashlib.md5(s3_content).hexdigest()
            results['aws'] = {
                'hash': s3_hash,
                'consistent': s3_hash == expected_hash,
                'size': len(s3_content)
            }
        except Exception as e:
            results['aws'] = {'status': 'error', 'error': str(e)}
        
        # 下载并验证Azure文件
        try:
            blob_client = self.azure_client.get_blob_client(container='test-container', blob=filename)
            azure_content = blob_client.download_blob().readall()
            azure_hash = hashlib.md5(azure_content).hexdigest()
            results['azure'] = {
                'hash': azure_hash,
                'consistent': azure_hash == expected_hash,
                'size': len(azure_content)
            }
        except Exception as e:
            results['azure'] = {'status': 'error', 'error': str(e)}
        
        # 下载并验证GCP文件
        try:
            bucket = self.gcp_client.bucket('test-bucket-gcp')
            blob = bucket.blob(filename)
            gcp_content = blob.download_as_text()
            gcp_hash = hashlib.md5(gcp_content.encode()).hexdigest()
            results['gcp'] = {
                'hash': gcp_hash,
                'consistent': gcp_hash == expected_hash,
                'size': len(gcp_content)
            }
        except Exception as e:
            results['gcp'] = {'status': 'error', 'error': str(e)}
        
        # 计算整体一致性
        consistent_clouds = [cloud for cloud, result in results.items() 
                           if result.get('consistent', False)]
        
        return {
            'results': results,
            'overall_consistent': len(consistent_clouds) == len(results),
            'consistent_clouds': consistent_clouds,
            'inconsistent_clouds': [cloud for cloud in results.keys() if cloud not in consistent_clouds]
        }

# 使用示例
tester = MultiCloudStorageTester()
test_content = b"Hello, Multi-Cloud Storage Test!"
expected_hash = hashlib.md5(test_content).hexdigest()

# 上传到所有云
upload_results = tester.upload_test_file(test_content, "consistency_test.txt")
print("上传结果:", upload_results)

# 验证一致性
consistency_results = tester.verify_consistency("consistency_test.txt", expected_hash)
print("一致性验证结果:", consistency_results)
```

#### 7.9 容器化存储测试

##### 7.9.1 容器存储架构

容器化环境下的存储测试需要考虑容器编排平台（如Kubernetes）的存储抽象和持久化机制。

**容器存储类型**：
- **EmptyDir**：临时存储，随Pod生命周期
- **HostPath**：主机路径挂载，直接访问宿主机存储
- **PersistentVolume (PV)**：集群级持久化存储
- **PersistentVolumeClaim (PVC)**：存储请求抽象

##### 7.9.2 容器存储测试关注点

**存储卷生命周期测试**：
- PV/PVC绑定和释放
- 存储类(StorageClass)配置验证
- 动态制备和静态制备
- 存储扩容和缩容

**数据持久性测试**：
- Pod重启后的数据保留
- 节点故障下的数据迁移
- 跨节点数据访问一致性

**性能隔离测试**：
- 存储I/O隔离和限流
- 多租户存储资源分配
- QoS保证和优先级

**代码示例 - Kubernetes存储测试**：

```yaml
# k8s_storage_test.yaml
# Kubernetes存储测试配置

apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: storage-test-pvc
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: fast-ssd
  resources:
    requests:
      storage: 10Gi
---
apiVersion: v1
kind: Pod
metadata:
  name: storage-test-pod
spec:
  containers:
  - name: test-container
    image: busybox
    command: ['sh', '-c', 'echo "Testing storage persistence" > /data/test.txt && sleep 3600']
    volumeMounts:
    - name: test-volume
      mountPath: /data
  volumes:
  - name: test-volume
    persistentVolumeClaim:
      claimName: storage-test-pvc
```

```python
# k8s_storage_test.py
# Kubernetes存储测试脚本

from kubernetes import client, config
import time

def test_k8s_storage_persistence():
    """
    测试Kubernetes存储持久性
    """
    config.load_kube_config()
    v1 = client.CoreV1Api()
    
    # 创建PVC
    pvc = client.V1PersistentVolumeClaim(
        metadata=client.V1ObjectMeta(name="test-pvc"),
        spec=client.V1PersistentVolumeClaimSpec(
            access_modes=["ReadWriteOnce"],
            storage_class_name="standard",
            resources=client.V1ResourceRequirements(
                requests={"storage": "1Gi"}
            )
        )
    )
    
    v1.create_namespaced_persistent_volume_claim("default", pvc)
    print("PVC创建成功")
    
    # 创建测试Pod
    pod = client.V1Pod(
        metadata=client.V1ObjectMeta(name="test-pod"),
        spec=client.V1PodSpec(
            containers=[client.V1Container(
                name="test",
                image="busybox",
                command=["sh", "-c", "echo 'test data' > /data/test.txt && sleep 30"]
            )],
            volumes=[client.V1Volume(
                name="test-volume",
                persistent_volume_claim=client.V1PersistentVolumeClaimVolumeSource(
                    claim_name="test-pvc"
                )
            )]
        )
    )
    
    v1.create_namespaced_pod("default", pod)
    print("测试Pod创建成功")
    
    # 等待Pod完成
    time.sleep(60)
    
    # 删除Pod
    v1.delete_namespaced_pod("test-pod", "default")
    print("原Pod删除")
    
    # 创建新Pod验证数据持久性
    new_pod = client.V1Pod(
        metadata=client.V1ObjectMeta(name="verify-pod"),
        spec=client.V1PodSpec(
            containers=[client.V1Container(
                name="verify",
                image="busybox",
                command=["sh", "-c", "cat /data/test.txt"]
            )],
            volumes=[client.V1Volume(
                name="test-volume",
                persistent_volume_claim=client.V1PersistentVolumeClaimVolumeSource(
                    claim_name="test-pvc"
                )
            )]
        )
    )
    
    v1.create_namespaced_pod("default", new_pod)
    print("验证Pod创建成功")
    
    # 检查验证结果
    time.sleep(30)
    pod_status = v1.read_namespaced_pod_status("verify-pod", "default")
    
    if pod_status.status.phase == "Succeeded":
        print("✓ 数据持久性测试通过")
        return True
    else:
        print("✗ 数据持久性测试失败")
        return False

# 使用示例
result = test_k8s_storage_persistence()
print(f"Kubernetes存储测试结果: {result}")
```

##### 7.9.4 容器存储专项测试指南

**Docker Volume 存储测试**：

```yaml
# docker_volume_test.yml
# Docker Volume存储测试配置

version: '3.8'
services:
  volume-tester:
    image: busybox
    command: >
      sh -c "
        echo 'Testing Docker volume persistence...' &&
        echo 'test-data-$(date)' > /data/test.txt &&
        ls -la /data/ &&
        cat /data/test.txt
      "
    volumes:
      - test-volume:/data

  volume-verifier:
    image: busybox
    command: >
      sh -c "
        echo 'Verifying Docker volume data...' &&
        ls -la /data/ &&
        cat /data/test.txt &&
        echo 'Data verification completed'
      "
    volumes:
      - test-volume:/data
    depends_on:
      - volume-tester

volumes:
  test-volume:
    driver: local
    driver_opts:
      type: tmpfs
      device: tmpfs
      o: "size=100m,uid=1000"
```

```python
# docker_volume_stress_test.py
# Docker Volume压力测试脚本

import docker
import time
import threading
import os
from concurrent.futures import ThreadPoolExecutor

class DockerVolumeStressTester:
    def __init__(self):
        self.client = docker.from_env()
        self.volume_name = "stress-test-volume"
        
    def create_test_volume(self):
        """创建测试卷"""
        try:
            volume = self.client.volumes.create(name=self.volume_name)
            print(f"✓ 创建测试卷: {self.volume_name}")
            return volume
        except Exception as e:
            print(f"✗ 创建测试卷失败: {e}")
            return None
    
    def run_write_test(self, file_id, data_size_mb=1):
        """运行写入测试"""
        container = self.client.containers.run(
            "busybox",
            command=f"dd if=/dev/urandom of=/data/test_{file_id}.dat bs=1M count={data_size_mb}",
            volumes={self.volume_name: {'bind': '/data', 'mode': 'rw'}},
            detach=True,
            remove=True
        )
        
        result = container.wait()
        return result['StatusCode'] == 0
    
    def run_read_test(self, file_id):
        """运行读取测试"""
        container = self.client.containers.run(
            "busybox", 
            command=f"dd if=/data/test_{file_id}.dat of=/dev/null bs=1M",
            volumes={self.volume_name: {'bind': '/data', 'mode': 'ro'}},
            detach=True,
            remove=True
        )
        
        result = container.wait()
        return result['StatusCode'] == 0
    
    def stress_test(self, concurrent_writes=5, concurrent_reads=10, duration_minutes=5):
        """运行压力测试"""
        print(f"开始Docker Volume压力测试...")
        print(f"并发写入: {concurrent_writes}, 并发读取: {concurrent_reads}, 持续时间: {duration_minutes}分钟")
        
        self.create_test_volume()
        
        end_time = time.time() + (duration_minutes * 60)
        write_count = 0
        read_count = 0
        
        with ThreadPoolExecutor(max_workers=concurrent_writes + concurrent_reads) as executor:
            while time.time() < end_time:
                # 提交写入任务
                for i in range(concurrent_writes):
                    executor.submit(self.run_write_test, write_count)
                    write_count += 1
                
                # 提交读取任务
                for i in range(concurrent_reads):
                    if write_count > i:  # 确保有数据可读
                        executor.submit(self.run_read_test, i)
                        read_count += 1
                
                time.sleep(1)  # 控制测试频率
        
        print(f"✓ 压力测试完成 - 写入操作: {write_count}, 读取操作: {read_count}")
        
        # 清理测试卷
        try:
            volume = self.client.volumes.get(self.volume_name)
            volume.remove()
            print("✓ 清理测试卷完成")
        except Exception as e:
            print(f"✗ 清理测试卷失败: {e}")

# 使用示例
tester = DockerVolumeStressTester()
tester.stress_test(concurrent_writes=3, concurrent_reads=5, duration_minutes=2)
```

**Podman 容器存储测试**：

```python
# podman_storage_test.py
# Podman容器存储测试脚本

import subprocess
import json
import time
import os

class PodmanStorageTester:
    def __init__(self):
        self.podman_cmd = "podman"
        
    def run_podman_command(self, cmd):
        """执行Podman命令"""
        try:
            result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
            return result.returncode == 0, result.stdout, result.stderr
        except Exception as e:
            return False, "", str(e)
    
    def test_volume_persistence(self):
        """测试卷持久性"""
        volume_name = "podman-test-volume"
        
        # 创建卷
        success, _, _ = self.run_podman_command(f"{self.podman_cmd} volume create {volume_name}")
        if not success:
            return {"status": "FAILED", "error": "创建卷失败"}
        
        # 在容器中写入数据
        write_cmd = f"""
        {self.podman_cmd} run --rm -v {volume_name}:/data busybox sh -c "
            echo 'Podman volume test data - $(date)' > /data/test.txt &&
            echo 'Additional test content' >> /data/test.txt
        "
        """
        success, _, _ = self.run_podman_command(write_cmd)
        if not success:
            return {"status": "FAILED", "error": "写入数据失败"}
        
        # 在新容器中读取数据
        read_cmd = f"""
        {self.podman_cmd} run --rm -v {volume_name}:/data busybox cat /data/test.txt
        """
        success, output, error = self.run_podman_command(read_cmd)
        
        # 清理卷
        self.run_podman_command(f"{self.podman_cmd} volume rm {volume_name}")
        
        if success and "Podman volume test data" in output:
            return {"status": "PASSED", "data": output.strip()}
        else:
            return {"status": "FAILED", "error": error, "output": output}
    
    def test_storage_driver_performance(self):
        """测试存储驱动性能"""
        results = {}
        
        # 测试overlay存储驱动
        overlay_cmd = f"""
        {self.podman_cmd} run --rm --storage-driver overlay busybox time dd if=/dev/zero of=/tmp/test.dat bs=1M count=100
        """
        success, output, _ = self.run_podman_command(overlay_cmd)
        if success:
            # 解析time命令输出
            results['overlay'] = self.parse_time_output(output)
        
        # 测试vfs存储驱动（如果可用）
        vfs_cmd = f"""
        {self.podman_cmd} run --rm --storage-driver vfs busybox time dd if=/dev/zero of=/tmp/test.dat bs=1M count=100
        """
        success, output, _ = self.run_podman_command(vfs_cmd)
        if success:
            results['vfs'] = self.parse_time_output(output)
        
        return results
    
    def parse_time_output(self, output):
        """解析time命令输出"""
        lines = output.split('\n')
        for line in lines:
            if 'real' in line:
                # 解析时间格式 (0m0.123s)
                time_str = line.split()[1]
                if 'm' in time_str and 's' in time_str:
                    minutes, seconds = time_str.split('m')
                    seconds = seconds.rstrip('s')
                    total_seconds = float(minutes) * 60 + float(seconds)
                    return total_seconds
        return None

# 使用示例
tester = PodmanStorageTester()

print("测试Podman卷持久性...")
volume_result = tester.test_volume_persistence()
print(f"卷持久性测试结果: {volume_result}")

print("测试存储驱动性能...")
performance_result = tester.test_storage_driver_performance()
print(f"性能测试结果: {performance_result}")
```

**Containerd 存储测试**：

```python
# containerd_storage_test.py
# Containerd存储测试脚本

import subprocess
import json
import time
import os

class ContainerdStorageTester:
    def __init__(self):
        self.ctr_cmd = "ctr"
        self.nerdctl_cmd = "nerdctl"  # 更用户友好的CLI
        
    def run_command(self, cmd, use_nerdctl=True):
        """执行容器命令"""
        command = self.nerdctl_cmd if use_nerdctl else self.ctr_cmd
        full_cmd = f"{command} {cmd}"
        
        try:
            result = subprocess.run(full_cmd, shell=True, capture_output=True, text=True)
            return result.returncode == 0, result.stdout, result.stderr
        except Exception as e:
            return False, "", str(e)
    
    def test_snapshotter_performance(self):
        """测试不同snapshotter的性能"""
        results = {}
        test_image = "busybox:latest"
        
        # 确保镜像存在
        self.run_command(f"pull {test_image}")
        
        # 测试overlayfs snapshotter
        start_time = time.time()
        success, _, _ = self.run_command(
            f"run --rm --snapshotter overlayfs {test_image} test-container true",
            use_nerdctl=False
        )
        if success:
            overlay_time = time.time() - start_time
            results['overlayfs'] = overlay_time
        
        # 测试native snapshotter
        start_time = time.time()
        success, _, _ = self.run_command(
            f"run --rm --snapshotter native {test_image} test-container true",
            use_nerdctl=False
        )
        if success:
            native_time = time.time() - start_time
            results['native'] = native_time
        
        return results
    
    def test_image_layers_integrity(self):
        """测试镜像层完整性"""
        test_image = "busybox:latest"
        
        # 拉取镜像
        success, _, error = self.run_command(f"pull {test_image}")
        if not success:
            return {"status": "FAILED", "error": f"拉取镜像失败: {error}"}
        
        # 检查镜像信息
        success, output, error = self.run_command(f"image inspect {test_image}")
        if not success:
            return {"status": "FAILED", "error": f"检查镜像失败: {error}"}
        
        try:
            image_info = json.loads(output)
            layers = image_info[0].get('Config', {}).get('rootfs', {}).get('diff_ids', [])
            
            return {
                "status": "PASSED",
                "layers_count": len(layers),
                "layers": layers[:3],  # 只显示前3层
                "total_size": image_info[0].get('Size', 0)
            }
        except json.JSONDecodeError as e:
            return {"status": "FAILED", "error": f"解析镜像信息失败: {e}"}
    
    def test_container_storage_quota(self):
        """测试容器存储配额"""
        # 创建临时目录作为存储根目录
        test_root = "/tmp/containerd-test"
        os.makedirs(test_root, exist_ok=True)
        
        # 使用配额运行容器
        quota_cmd = f"""
        run --rm --storage-root {test_root} --quota 100MB busybox:latest quota-test sh -c "
            dd if=/dev/zero of=/tmp/test.dat bs=1M count=50 &&
            echo 'Quota test: 50MB file created successfully'
        "
        """
        
        success, output, error = self.run_command(quota_cmd)
        
        # 清理测试目录
        import shutil
        shutil.rmtree(test_root, ignore_errors=True)
        
        if success and "successfully" in output:
            return {"status": "PASSED", "message": "配额测试通过"}
        else:
            return {"status": "FAILED", "error": error, "output": output}

# 使用示例
tester = ContainerdStorageTester()

print("测试snapshotter性能...")
perf_result = tester.test_snapshotter_performance()
print(f"性能测试结果: {perf_result}")

print("测试镜像层完整性...")
integrity_result = tester.test_image_layers_integrity()
print(f"完整性测试结果: {integrity_result}")

print("测试存储配额...")
quota_result = tester.test_container_storage_quota()
print(f"配额测试结果: {quota_result}")
```

